{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "dist",
    "src/components/arrival",
    "src/components/auth",
    "src/components/community",
    "src/components/dashboard",
    "src/components/finder",
    "src/components/grocery",
    "src/components/guide",
    "src/components/hangul",
    "src/components/healthcare",
    "src/components/home",
    "src/components/housing",
    "src/components/jobs",
    "src/components/layout",
    "src/components/marketplace",
    "src/components/shop",
    "src/components/survival",
    "src/components/transit",
    "src/components/universities",
    "src/components/visa",
    "src/data/universities"
  ]
}
