# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for internal runtime health checks. Outgoing emails always use PUBLIC_SITE_URL (https://everykr.com).
APP_URL="MY_APP_URL"
PUBLIC_SITE_URL="https://everykr.com"
PASSWORD_RESET_ACTION_URL="https://everykr.com/reset-password"

# DEDICATED FIREBASE PROJECT CONFIGURATION (EVERYKR)
# Configure these variables to override the default EveryKR Firebase project if needed.
VITE_FIREBASE_API_KEY="AIzaSyAgJyMMBxCO6GZgSsh7a6xMolDs7JzTscQ"
VITE_FIREBASE_AUTH_DOMAIN="everykr.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="everykr"
VITE_FIREBASE_STORAGE_BUCKET="everykr.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="926172198407"
VITE_FIREBASE_APP_ID="1:926172198407:web:eb679714ecb801edd99ca2"
VITE_FIREBASE_MEASUREMENT_ID="G-FPCP0M668Y"
# Optional server-only Firebase Admin service account JSON (raw or base64) for cross-project/local environments.
# On Cloud Run inside project "everykr", Application Default Credentials work automatically when the runtime service account has Firebase Auth Admin / Editor permissions.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# EVERYKR NEWSLETTER & TRANSACTIONAL EMAIL DELIVERY (SERVER-SIDE ONLY)
# Configure BREVO_API_KEY, RESEND_API_KEY, or SMTP_* for live inbox email delivery.
# Never prefix these keys with VITE_ so they remain strictly on the server.
BREVO_API_KEY=""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM_NAME="EveryKR Newsletter"
EMAIL_FROM_ADDRESS="newsletter@everykr.com"
NEWSLETTER_FROM_NAME="EveryKR Newsletter"
NEWSLETTER_FROM_EMAIL="newsletter@everykr.com"
ACCOUNT_EMAIL_FROM_NAME="EveryKR Account Team"
ACCOUNT_EMAIL_FROM_ADDRESS="account@everykr.com"
SECURITY_EMAIL_FROM_NAME="EveryKR Account Security"
SECURITY_EMAIL_FROM_ADDRESS="security@everykr.com"
EMAIL_REPLY_TO="support@everykr.com"
# REQUIRED IN PRODUCTION (Cloud Run Secret Manager — never leave unset in production):
NEWSLETTER_SIGNING_SECRET=""
NEWSLETTER_HMAC_SECRET=""
OTP_SIGNING_SECRET=""
SESSION_SIGNING_SECRET=""
PASSPORT_ENCRYPTION_SECRET=""
