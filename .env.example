# GOOGLE reCAPTCHA v2 CHECKBOX PROTECTION (PHASE 12)
# IMPORTANT: Verify whether your registered Google keys are Standard reCAPTCHA v2 ("v2_checkbox", verified via SiteVerify)
# or Google Cloud reCAPTCHA Enterprise ("enterprise", verified via CreateAssessment). Never mix both modes.
RECAPTCHA_KEY_TYPE="v2_checkbox"
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SITE_KEY=""
# SERVER-SIDE ONLY SECRET KEY (for RECAPTCHA_KEY_TYPE="v2_checkbox" — NEVER prefix with VITE_):
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_ALLOWED_HOSTNAMES="everykr.com,www.everykr.com"
# Optional ONLY if RECAPTCHA_KEY_TYPE="enterprise" (leave empty when using standard reCAPTCHA v2 Checkbox):
RECAPTCHA_ENTERPRISE_PROJECT_ID=""
RECAPTCHA_ENTERPRISE_API_KEY=""

# EVERYKR LIVE FLIGHT SEARCH & PRICE VERIFICATION ENGINE (SERVER-SIDE ONLY)
# Never prefix these keys with VITE_ so they remain strictly on the backend server.
# Primary Provider — SerpApi Google Flights Engine ("google_flights"):
SERPAPI_API_KEY=""
# Secondary / Future Providers — Amadeus Self-Service / Production GDS & Skyscanner Partner API:
# AMADEUS_API_ENV supports "test" (https://test.api.amadeus.com) or "production" (https://api.amadeus.com).
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_API_ENV="test"
# Optional Skyscanner Flights Live Prices API key (requires commercial partner approval):
SKYSCANNER_API_KEY=""

# EVERYKR SMART TRANSPORTATION HUB — KTX TRAIN & BUS TIMETABLE DISCOVERY (SERVER-SIDE ONLY)
# Official Korea Public Data Portal (data.go.kr) TAGO Open API service key for:
